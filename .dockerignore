# Docker build context — lean image for operator console only
.git
.gitignore
.cursor
.idea
.vscode
**/.DS_Store
**/node_modules
**/.dart_tool
# Do NOT ignore **/build — that also drops vendor assets like
# services/*/assets/libs/alertifyjs/build/*.css|js (MIME text/html 404s in browser).
apps/customer-mobile/**/build
apps/admin-mobile/**/build
**/.gradle
**/*.apk
**/*.log

archive
docs
apps/customer-mobile
apps/admin-mobile
services/cargo/qz-tray
deploy/docker/tmp
agent-transcripts

# Raw dumps (use database/seed/ instead)
database/cargo.sql
database/ticket.sql
database/account.sql
database/*.sql.bak

# Keep seed gz + sql
# (do not blanket-ignore *.sql.gz)

**/*.md
