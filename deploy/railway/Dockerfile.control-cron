# Tessera Control alert cron (Wave I5)
# Deploy as a Railway cron service: image curlimages/curl, startCommand runs this script pattern.
FROM curlimages/curl:8.11.1
COPY control-cron.sh /control-cron.sh
# Railway injects CONTROL_CRON_TOKEN; schedule set via serviceInstanceUpdate cronSchedule
ENTRYPOINT ["/bin/sh", "/control-cron.sh"]
